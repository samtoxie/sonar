{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonar",
  "version": "0.1.1",
  "identifier": "dev.sonar.filemanager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Sonar",
        "width": 1100,
        "height": 700,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: sonar: http://sonar.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "files": {
          "/usr/share/xdg-desktop-portal/portals/org.freedesktop.impl.portal.desktop.sonar.portal": "linux/org.freedesktop.impl.portal.desktop.sonar.portal",
          "/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.sonar.service": "linux/org.freedesktop.impl.portal.desktop.sonar.service"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/xdg-desktop-portal/portals/org.freedesktop.impl.portal.desktop.sonar.portal": "linux/org.freedesktop.impl.portal.desktop.sonar.portal",
          "/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.sonar.service": "linux/org.freedesktop.impl.portal.desktop.sonar.service"
        }
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
